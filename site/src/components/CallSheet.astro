---
// The city sheet behind every «Подзвонити»: a dropdown under the button on desktop, a bottom sheet on a phone.
// Native <dialog>: Esc, focus containment and a return of focus to the button (src/scripts/call-sheet.ts).
import Icon from "./Icon.astro";
import { stations } from "../data/site";
---
<dialog id="call-sheet" class="sheet" aria-labelledby="call-sheet-title">
  <div class="sheet__inner">
    <div class="sheet__head">
      <p id="call-sheet-title" class="sheet__title">Куди подзвонити?</p>
      <button type="button" class="sheet__close" data-sheet-close aria-label="Закрити">
        <Icon name="close" />
      </button>
    </div>
    <ul class="sheet__list">
      {stations.map((s) => (
        <li>
          <a class="sheet__city" href={`tel:${s.phones[0].tel}`}>
            <span class="sheet__name">{s.city}, {s.district}</span>
            <span class="sheet__phone num">{s.phones[0].label}</span><span class="visually-hidden">;</span>
            <Icon name="phone" />
          </a>
        </li>
      ))}
    </ul>
    <p class="sheet__more"><a class="link" href="#stations" data-sheet-close>Усі номери і графік</a></p>
  </div>
</dialog>

<style>
  .sheet { position: fixed; inset: auto 0 0 0; width: 100%; max-width: 100%; margin: 0; padding: 0; border: 0; border-radius: var(--radius) var(--radius) 0 0; background: var(--color-bg); color: var(--color-text); box-shadow: var(--shadow-sheet); opacity: 0; transform: translateY(100%); transition: opacity var(--dur-exit) var(--ease-in), transform var(--dur-exit) var(--ease-in); }
  .sheet[open].is-open { opacity: 1; transform: none; transition: opacity var(--dur-sheet) var(--ease-out), transform var(--dur-sheet) var(--ease-out); }
  .sheet::backdrop { background: var(--color-scrim); }
  .sheet__inner { padding: var(--space-md) var(--space) calc(var(--space-lg) + env(safe-area-inset-bottom)); }
  .sheet__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); margin-bottom: var(--space-xs); }
  .sheet__title { font: 600 var(--text-md)/1.3 var(--font-body); }
  .sheet__close { display: inline-grid; place-items: center; width: var(--control-h-s); height: var(--control-h-s); margin-right: calc(-1 * var(--space-sm)); border: 0; border-radius: var(--radius); background: transparent; color: var(--color-text); cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out); }
  .sheet__close:hover { background: var(--color-surface); }
  .sheet__list { display: grid; }
  .sheet__list li + li { border-top: 1px solid var(--color-rule); }
  .sheet__city { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name icon" "phone icon"; align-items: center; column-gap: var(--space-md); padding: var(--space-md) 0; min-height: var(--control-h); text-decoration: none; transition: color var(--dur-micro) var(--ease-out); }
  .sheet__city:hover { color: var(--color-accent); }
  .sheet__name { grid-area: name; font-size: var(--text-sm); color: var(--color-muted); }
  .sheet__phone { grid-area: phone; font: 800 var(--text-title)/1.15 var(--font-display); letter-spacing: var(--track-display); }
  .sheet__city :global(.icon) { grid-area: icon; width: var(--icon-l); height: var(--icon-l); }
  .sheet__more { margin-top: var(--space-xs); font-size: var(--text-sm); }
  .sheet__more a { display: inline-flex; align-items: center; min-height: var(--control-h-s); }

  @media (min-width: 48rem) {
    .sheet { inset: var(--sheet-y, var(--space-3xl)) auto auto var(--sheet-x, 50%); width: 22rem; border-radius: var(--radius); transform: translateY(8px); }
    .sheet::backdrop { background: transparent; }
    .sheet[open].is-open { transition-duration: var(--dur-short); }
    .sheet__inner { padding: var(--space-md) var(--space-lg) var(--space-md); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet, .sheet[open].is-open { transform: none; transition: none; }
  }
</style>
